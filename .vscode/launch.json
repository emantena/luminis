    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Luminis — Mock API (USB)",
            "cwd": "frontend\\luminis_app",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "luminis: preparar mock no aparelho",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://127.0.0.1:3000/api"
            ]
        },
        {
            "name": "luminis_app (profile mode)",
            "cwd": "frontend\\luminis_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "luminis_app (release mode)",
            "cwd": "frontend\\luminis_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
